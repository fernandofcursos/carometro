# =============================================================================
# .env.dev — Variáveis de ambiente para desenvolvimento local
#
# Copie para .env e ajuste conforme necessário.
# NUNCA commite o .env com valores reais.
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# PostgreSQL INTERNO ao container dev (padrão)
DATABASE_URL=postgresql://carometro:carometro@localhost:5432/carometro

# PostgreSQL EXTERNO (Neon cloud)
# Descomente e cole a connection string do Neon para usar
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/carometro?sslmode=require

# Credenciais do PG local (usadas pelo entrypoint para criar o banco)
PGUSER=carometro
PGPASSWORD=carometro
PGDATABASE=carometro

# ---------------------------------------------------------------------------
# Segurança da aplicação
# ---------------------------------------------------------------------------

# SESSION_SECRET — string aleatória mínimo 64 chars
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=dev-secret-troque-em-producao-minimo-64-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ENCRYPTION_KEY — chave AES-256 para criptografia de dados (e-mail, fotos, biometria)
# DEVE ser diferente da SESSION_SECRET para que rotação de JWT não invalide dados criptografados
# Derivada do SESSION_SECRET de desenvolvimento (SHA-256) — em produção, gerar valor próprio:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=bc30887220cb03c633dbb28769b0dc8796b64e4e62490e432534f72118a64288

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
BASE_PATH=/
LOG_LEVEL=debug

# URL do frontend para CORS (usado pelo api-server)
FRONTEND_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# LGPD
# ---------------------------------------------------------------------------
# Versão atual da política de privacidade (exibida no modal de consentimento)
POLITICA_VERSAO=1.0

# ---------------------------------------------------------------------------
# Admin inicial
# ---------------------------------------------------------------------------
# E-mail do primeiro administrador criado automaticamente pelo entrypoint
# quando o banco está vazio. O código de acesso e senha temporária são
# exibidos no terminal.
ADMIN_EMAIL=admin@escola.edu.br

# ---------------------------------------------------------------------------
# Banco de dados externo (Neon cloud)
# Descomente e substitua pela sua connection string do Neon:
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/carometro?sslmode=require
# ---------------------------------------------------------------------------
