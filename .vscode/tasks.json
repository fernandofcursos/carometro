{
  // ==========================================================================
  // .vscode/tasks.json
  //
  // Tasks que rodam DENTRO do container (o VSCode encaminha os comandos
  // via SSH para o servidor remoto Linux — não executa no Mac).
  //
  // Ctrl+Shift+B = tarefa padrão (subir tudo)
  // Ctrl+Shift+P → "Tasks: Run Task" = lista todas as tarefas
  // ==========================================================================
  "version": "2.0.0",
  "tasks": [

    // ------------------------------------------------------------------------
    // TAREFA PADRÃO — Ctrl+Shift+B
    // Sobe frontend (Vite) e api-server em paralelo
    // ------------------------------------------------------------------------
    {
      "label": "🚀 Carômetro: subir tudo",
      "dependsOn": [
        "Frontend: Vite dev server",
        "API: api-server dev"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "dev"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },

    // ------------------------------------------------------------------------
    // Frontend — Vite na porta 5000
    // Idêntico ao comando do Replit (.replit → workflows → Start application)
    // ------------------------------------------------------------------------
    {
      "label": "Frontend: Vite dev server",
      "type": "shell",
      "command": "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/carometro run dev",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "label": "Frontend :5000"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },

    // ------------------------------------------------------------------------
    // API Server — Express na porta 8080
    // Só funciona após a Fase 1 (quando artifacts/api-server existir)
    // ------------------------------------------------------------------------
    {
      "label": "API: api-server dev",
      "type": "shell",
      "command": "[ -f artifacts/api-server/package.json ] && PORT=8080 pnpm --filter @workspace/api-server run dev || echo '⚠️  api-server não encontrado'",
      "options": {
        "env": {
          "PORT": "8080"
        }
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "label": "API :8080"
      },
      "problemMatcher": []
    },

    // ------------------------------------------------------------------------
    // Schema do banco
    // ------------------------------------------------------------------------
    {
      "label": "DB: aplicar schema (drizzle push)",
      "type": "shell",
      "command": "pnpm --filter @workspace/db run push",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "DB Push"
      },
      "problemMatcher": []
    },

    // ------------------------------------------------------------------------
    // Codegen — Orval regenera hooks e schemas Zod
    // Rodar sempre após mudar openapi.yaml
    // ------------------------------------------------------------------------
    {
      "label": "Codegen: regenerar hooks e schemas (Orval)",
      "type": "shell",
      "command": "pnpm --filter @workspace/api-spec run codegen",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "Codegen"
      },
      "problemMatcher": []
    },

    // ------------------------------------------------------------------------
    // TypeScript — verificar tipos em todos os pacotes
    // ------------------------------------------------------------------------
    {
      "label": "TypeScript: typecheck completo",
      "type": "shell",
      "command": "pnpm run typecheck",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "TypeCheck"
      },
      "problemMatcher": "$tsc"
    },

    // ------------------------------------------------------------------------
    // Instalar dependências
    // ------------------------------------------------------------------------
    {
      "label": "pnpm: instalar dependências",
      "type": "shell",
      "command": "pnpm install --prefer-frozen-lockfile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "pnpm install"
      },
      "problemMatcher": []
    },

    // ------------------------------------------------------------------------
    // Criar administrador inicial
    // ------------------------------------------------------------------------
    {
      "label": "Scripts: criar admin inicial",
      "type": "shell",
      "command": "pnpm --filter @workspace/scripts run seed-admin ${input:adminEmail}",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "Seed Admin"
      },
      "problemMatcher": []
    }
  ],

  // --------------------------------------------------------------------------
  // Inputs para tarefas que precisam de parâmetros
  // --------------------------------------------------------------------------
  "inputs": [
    {
      "id": "adminEmail",
      "type": "promptString",
      "description": "E-mail do administrador",
      "default": "admin@escola.edu.br"
    }
  ]
}
