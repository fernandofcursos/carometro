{
  // ==========================================================================
  // .vscode/settings.json
  //
  // Configurações do workspace. Quando o VSCode está conectado ao container,
  // estas configurações são aplicadas ao servidor remoto (Linux).
  // ==========================================================================

  // --------------------------------------------------------------------------
  // TypeScript
  // --------------------------------------------------------------------------
  // Usar o TypeScript do projeto (5.9) — NÃO o bundled do VSCode (mais antigo)
  "typescript.tsdk": "/workspace/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",

  // --------------------------------------------------------------------------
  // Formatação
  // --------------------------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.tabSize": 2,
  "editor.rulers": [100],

  // --------------------------------------------------------------------------
  // ESLint — ciente dos workspaces pnpm
  // --------------------------------------------------------------------------
  "eslint.workingDirectories": [
    { "pattern": "artifacts/*" },
    { "pattern": "lib/*" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // --------------------------------------------------------------------------
  // Tailwind CSS 4
  // --------------------------------------------------------------------------
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  // Ativar Tailwind em todos os arquivos tsx/ts relevantes
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascriptreact"
  },

  // --------------------------------------------------------------------------
  // Formatação por tipo de arquivo
  // --------------------------------------------------------------------------
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[sql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // --------------------------------------------------------------------------
  // Terminal — usa bash do container, não o zsh do Mac
  // --------------------------------------------------------------------------
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/bin/bash",
      "icon": "terminal-bash"
    }
  },
  // Tamanho de fonte ligeiramente maior (confortável para dev)
  "terminal.integrated.fontSize": 13,

  // --------------------------------------------------------------------------
  // Explorer — esconder pastas que não precisam de edição
  // --------------------------------------------------------------------------
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": false,        // manter git visível
    "**/dist": true,
    "**/.tmp-introspect": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.tmp-introspect": true,
    "**/lib/api-client-react/src/generated": true,  // código gerado — não buscar aqui
    "**/lib/api-zod/src/generated": true
  },

  // --------------------------------------------------------------------------
  // Git — funciona dentro do container (git está instalado)
  // --------------------------------------------------------------------------
  "git.autofetch": true,
  "git.confirmSync": false,
  "gitlens.hovers.currentLine.over": "line",

  // --------------------------------------------------------------------------
  // Banco de dados (extensão cweijan.vscode-database-client2)
  // --------------------------------------------------------------------------
  "database-client.autoConnect": false  // conexão manual para não expor credenciais
}
