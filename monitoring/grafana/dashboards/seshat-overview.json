{
  "title": "Seshat — Visão Geral",
  "uid": "seshat-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["seshat", "api", "postgres"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requisições (último minuto)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total[1m]))",
        "legendFormat": "req/s"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erros 5xx (último minuto)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m]))",
        "legendFormat": "erros/s"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 0.1 }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latência p95 (últimos 5 min)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requisições em voo",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "http_requests_in_flight",
        "legendFormat": "em voo"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requisições por rota (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by (route, method) (rate(http_requests_total[1m]))",
        "legendFormat": "{{method}} {{route}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência por rota (p95)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{route}} p95"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memória Node.js (heap)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{job=\"seshat_api\"}",
          "legendFormat": "RSS"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "nodejs_heap_size_used_bytes{job=\"seshat_api\"}",
          "legendFormat": "Heap usado"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "nodejs_heap_size_total_bytes{job=\"seshat_api\"}",
          "legendFormat": "Heap total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PostgreSQL — conexões ativas",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "pg_stat_activity_count{datname=\"seshat\"}",
        "legendFormat": "conexões"
      }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Status HTTP por código",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by (status_code) (rate(http_requests_total[5m]))",
        "legendFormat": "HTTP {{status_code}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PostgreSQL — tamanho do banco",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 6 },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "pg_database_size_bytes{datname=\"seshat\"}",
        "legendFormat": "tamanho"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
