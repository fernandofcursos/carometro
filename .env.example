# =============================================================================
# .env.example — Fase 7: template de variáveis de ambiente para produção
#
# Copie este arquivo para .env (NÃO commitar o .env com valores reais)
#   cp .env.example .env
#
# Gere SESSION_SECRET com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Opção A — PostgreSQL local (docker-compose.prod.yml com serviço db)
DATABASE_URL=postgresql://seshat:TROQUE_A_SENHA@db:5432/seshat

# Opção B — Neon cloud (remova o comentário e preencha a string do Neon)
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/seshat?sslmode=require&channel_binding=require

# Credenciais do PostgreSQL local (usadas pelo serviço db no docker-compose.prod.yml)
# Deve corresponder ao DATABASE_URL acima
POSTGRES_USER=seshat
POSTGRES_PASSWORD=TROQUE_A_SENHA
POSTGRES_DB=seshat

# ---------------------------------------------------------------------------
# Segurança — OBRIGATÓRIO trocar em produção
# ---------------------------------------------------------------------------

# Mínimo 64 caracteres aleatórios — usado para JWT (assinar tokens)
SESSION_SECRET=GERE_COM_node_-e_console.log_require_crypto_.randomBytes_64_.toString_hex_

# Chave AES-256 para criptografia de dados (e-mail, fotos, biometria)
# DEVE ser diferente da SESSION_SECRET — rotacionar JWT não invalida dados criptografados
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=GERE_COM_node_-e_console.log_require_crypto_.randomBytes_32_.toString_hex_

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
BASE_PATH=/

# URL pública do frontend — usada pelo api-server para configurar CORS
# Em produção: domínio real (ex: https://seshat.escola.edu.br)
FRONTEND_URL=https://localhost

# ---------------------------------------------------------------------------
# E-mail — envio de recuperação de senha
# Se não configurado, usa Ethereal (serviço de teste) e exibe URL no log da API
# ---------------------------------------------------------------------------

# Host SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, smtp.office365.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua-senha-de-app
# Remetente exibido no e-mail
# SMTP_FROM=Carômetro <noreply@suaescola.edu.br>

# ---------------------------------------------------------------------------
# Admin inicial — criado automaticamente no primeiro deploy
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@escola.edu.br
