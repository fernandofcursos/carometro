# =============================================================================
# .env.example — Fase 7: template de variáveis de ambiente para produção
#
# Copie este arquivo para .env (NÃO commitar o .env com valores reais)
#   cp .env.example .env
#
# Gere SESSION_SECRET com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Opção A — PostgreSQL local (docker-compose.prod.yml com serviço db)
DATABASE_URL=postgresql://seshat:TROQUE_A_SENHA@db:5432/seshat

# Opção B — Neon cloud (remova o comentário e preencha a string do Neon)
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/seshat?sslmode=require&channel_binding=require

# Credenciais do PostgreSQL local (usadas pelo serviço db no docker-compose.prod.yml)
# Deve corresponder ao DATABASE_URL acima
POSTGRES_USER=seshat
POSTGRES_PASSWORD=TROQUE_A_SENHA
POSTGRES_DB=seshat

# ---------------------------------------------------------------------------
# Segurança — OBRIGATÓRIO trocar em produção
# ---------------------------------------------------------------------------

# Mínimo 64 caracteres aleatórios — usado para JWT (assinar tokens)
SESSION_SECRET=GERE_COM_node_-e_console.log_require_crypto_.randomBytes_64_.toString_hex_

# Chave AES-256 para criptografia de dados (e-mail, fotos, biometria)
# DEVE ser diferente da SESSION_SECRET — rotacionar JWT não invalida dados criptografados
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=GERE_COM_node_-e_console.log_require_crypto_.randomBytes_32_.toString_hex_

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
BASE_PATH=/

# URL pública do frontend — usada pelo api-server para configurar CORS
# Em produção: domínio real (ex: https://seshat.escola.edu.br)
FRONTEND_URL=https://localhost

# ---------------------------------------------------------------------------
# E-mail — envio transacional
# Prioridade: Resend > SMTP > captura local
# ---------------------------------------------------------------------------

# Opção A — Resend (recomendado; funciona em qualquer ambiente via HTTPS/443)
# Crie conta em resend.com → API Keys → Create API Key
# Para testes sem domínio verificado, o remetente padrão é onboarding@resend.dev
# Para domínio próprio, verifique em resend.com e defina RESEND_FROM
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Seshat <noreply@seudominio.com.br>

# Opção B — Gmail SMTP (requer porta 587 disponível no servidor)
# Use uma Senha de App (não a senha da conta Google)
# Gere em: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreplay.seshat.etsm@gmail.com
SMTP_PASS=SENHA_DE_APP_16_CHARS_GERADA_NO_GOOGLE
SMTP_FROM=Seshat <noreplay.seshat.etsm@gmail.com>

# ---------------------------------------------------------------------------
# Admin inicial — criado automaticamente no primeiro deploy
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@escola.edu.br

# ---------------------------------------------------------------------------
# Monitoramento — Prometheus + Grafana (produção)
# ---------------------------------------------------------------------------

# Grafana — credenciais do admin (OBRIGATÓRIO alterar em produção)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SENHA_FORTE_AQUI

# postgres-exporter — usuário de leitura do PostgreSQL (mínimo privilégio)
# Criado automaticamente pelo scripts/init-monitoring-user.sql na primeira inicialização
PG_EXPORTER_USER=seshat_monitor
PG_EXPORTER_PASSWORD=SENHA_FORTE_AQUI

# ---------------------------------------------------------------------------
# Gerar senha para HTTP Basic Auth do /prometheus/ (nginx):
#   htpasswd -c nginx/monitoring.htpasswd admin_monitoramento
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# n8n — automação de fluxos e integração (Slack, e-mail, webhooks)
# Acesso: https://SEU_DOMINIO/n8n/
# ---------------------------------------------------------------------------

# Chave de criptografia das credenciais armazenadas no n8n (AES-256)
# OBRIGATÓRIO em produção — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=GERE_COM_node_-e_console.log_require_crypto_.randomBytes_32_.toString_hex_

# ---------------------------------------------------------------------------
# Slack — integração via n8n (Incoming Webhook ou Slack App)
#
# Opção A — Incoming Webhook (mais simples):
#   1. Acesse api.slack.com/apps → Create New App → From scratch
#   2. Ative "Incoming Webhooks" → Add New Webhook to Workspace
#   3. Copie a URL gerada abaixo
#   4. No n8n: use o node "HTTP Request" ou "Slack" apontando para esta URL
#
# Opção B — Slack App com Bot Token (mais recursos — DMs, canais dinâmicos):
#   1. Crie um Slack App em api.slack.com/apps
#   2. Adicione Bot Token Scopes: chat:write, channels:read
#   3. Instale no workspace e copie o Bot Token abaixo
#   4. No n8n: configure a credencial "Slack" com o token
#
# Ambas as opções são configuradas no n8n via interface — não no código.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TROQUE/ESTE/WEBHOOK
# SLACK_BOT_TOKEN=xoxb-TROQUE-ESTE-TOKEN
