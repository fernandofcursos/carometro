{
  // ==========================================================================
  // .devcontainer/devcontainer.json
  //
  // Configura o VSCode para abrir o projeto DENTRO do container Docker,
  // ambiente de desenvolvimento containerizado.
  //
  // Documentação: https://containers.dev/implementors/json_reference/
  // ==========================================================================
  "name": "Seshat Dev",

  // Usar o docker-compose.yml que já existe no projeto
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",

  // VSCode substitui o entrypoint/command do container pelo VS Code Server
  // Sem isso, o entrypoint.sh toma controle e o VSCode não consegue conectar
  "overrideCommand": true,

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "DISABLE_AUTOUPDATER": "0"
  },

  // --------------------------------------------------------------------------
  // Extensões instaladas DENTRO do container
  // Estas extensões rodam no servidor remoto (dentro do Linux do container),
  // não na UI do VSCode no Mac. Isso é importante para TypeScript, ESLint etc.
  // funcionarem corretamente com os paths do Linux.
  // --------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript
        "ms-vscode.vscode-typescript-next",
        "yoavbls.pretty-ts-errors",

        // Qualidade de código
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",

        // Tailwind CSS 4
        "bradlc.vscode-tailwindcss",

        // Banco de dados
        "cweijan.vscode-database-client2",

        // DX
        "mikestead.dotenv",
        "usernamehw.errorlens"
      ],

      "settings": {
        // TypeScript: usar a versão instalada no projeto, não a do VSCode
        "typescript.tsdk": "/workspace/node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,

        // Formatar ao salvar
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Tailwind CSS 4 — suporte a cva() e cx()
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],

        // ESLint ciente dos workspaces pnpm
        "eslint.workingDirectories": [
          { "pattern": "artifacts/*" },
          { "pattern": "lib/*" }
        ],

        // Terminal padrão dentro do container = bash
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.shell.linux": "/bin/bash",

        // Conexão automática com o PostgreSQL interno
        "database-client.autoConnect": true,

        // Formatar por tipo de arquivo
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  },

  // --------------------------------------------------------------------------
  // Variáveis de ambiente adicionais dentro do container
  // Complementam o env_file do docker-compose (.env + .env.local).
  // --------------------------------------------------------------------------
  "remoteEnv": {
    "NODE_ENV": "development",
    "BASE_PATH": "/"
  },

  // --------------------------------------------------------------------------
  // Usuário remoto — mesmo usuário definido no Dockerfile
  // --------------------------------------------------------------------------
  "remoteUser": "root",

  // --------------------------------------------------------------------------
  // Portas encaminhadas automaticamente para o Mac
  // O VSCode abre estas portas no browser quando o container as anuncia
  // --------------------------------------------------------------------------
  "forwardPorts": [5000, 8080, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8080": {
      "label": "API Server",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // --------------------------------------------------------------------------
  // Comando executado UMA VEZ ao criar o container (post-create)
  // --------------------------------------------------------------------------
  // Instala dependências na primeira criação do container
  "postCreateCommand": "cd /workspace && pnpm install --frozen-lockfile 2>/dev/null || pnpm install",

  // Sobe o PostgreSQL a cada start — sai rápido se já estiver rodando
  "postStartCommand": "bash /workspace/scripts/start-db.sh"
}
