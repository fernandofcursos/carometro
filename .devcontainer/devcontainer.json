{
  // ==========================================================================
  // .devcontainer/devcontainer.json
  //
  // Configura o VSCode para abrir o projeto DENTRO do container Docker.
  //
  // Usa "build.dockerfile" (docker build) em vez de "dockerComposeFile"
  // (docker compose build) para evitar o formato Bake do Docker Compose v5,
  // que é incompatível com o BuildKit v0.37.2 do Docker Desktop 4.95+.
  //
  // O docker-compose.yml ainda existe para uso manual (docker compose up),
  // mas o devcontainer não depende dele para o build.
  //
  // Documentação: https://containers.dev/implementors/json_reference/
  // ==========================================================================
  "name": "Seshat Dev",

  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",

  // VSCode substitui o entrypoint/command do container pelo VS Code Server
  "overrideCommand": true,

  // Roda NO HOST antes de subir o container:
  //   1. Cria o volume externo seshat-pg-dev se não existir
  //   2. Cria/atualiza .env de desenvolvimento
  //   3. Garante que .env.local exista (pode ser vazio) para o --env-file abaixo
  "initializeCommand": "bash ${localWorkspaceFolder}/scripts/criar-volume-pg.sh && bash ${localWorkspaceFolder}/scripts/criar-env-dev.sh",

  // Equivalente ao cap_add + volumes + env_file do docker-compose.yml
  "runArgs": [
    "--name=seshat-dev",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--env-file=${localWorkspaceFolder}/.env",
    "--env-file=${localWorkspaceFolder}/.env.local"
  ],

  "mounts": [
    "source=seshat-pnpm-store,target=/root/.pnpm-store,type=volume",
    "source=seshat-pg-dev,target=/var/lib/postgresql/16/main,type=volume",
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "DISABLE_AUTOUPDATER": "0"
  },

  // --------------------------------------------------------------------------
  // Extensões instaladas DENTRO do container
  // --------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript
        "ms-vscode.vscode-typescript-next",
        "yoavbls.pretty-ts-errors",

        // Qualidade de código
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",

        // Tailwind CSS 4
        "bradlc.vscode-tailwindcss",

        // Banco de dados
        "cweijan.vscode-database-client2",

        // DX
        "mikestead.dotenv",
        "usernamehw.errorlens",

        // Qualidade — SonarLint
        "sonarsource.sonarlint-vscode"
      ],

      "settings": {
        // TypeScript: usar a versão instalada no projeto, não a do VSCode
        "typescript.tsdk": "/workspace/node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,

        // Formatar ao salvar
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Tailwind CSS 4 — suporte a cva() e cx()
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],

        // ESLint ciente dos workspaces pnpm
        "eslint.workingDirectories": [
          { "pattern": "artifacts/*" },
          { "pattern": "lib/*" }
        ],

        // Terminal padrão dentro do container = bash
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.shell.linux": "/bin/bash",

        // Conexão automática com o PostgreSQL interno
        "database-client.autoConnect": true,

        // Formatar por tipo de arquivo
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  },

  // --------------------------------------------------------------------------
  // Variáveis de ambiente adicionais dentro do container
  // A maioria vem do .env via --env-file no runArgs acima.
  // --------------------------------------------------------------------------
  "remoteEnv": {
    "NODE_ENV": "development",
    "BASE_PATH": "/"
  },

  // --------------------------------------------------------------------------
  // Usuário remoto — mesmo usuário definido no Dockerfile
  // --------------------------------------------------------------------------
  "remoteUser": "root",

  // --------------------------------------------------------------------------
  // Portas encaminhadas automaticamente para o Mac
  // --------------------------------------------------------------------------
  "forwardPorts": [5000, 8080, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8080": {
      "label": "API Server",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // --------------------------------------------------------------------------
  // Comando executado UMA VEZ ao criar o container (post-create)
  // --------------------------------------------------------------------------
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code 2>/dev/null; cd /workspace && pnpm install --frozen-lockfile 2>/dev/null || pnpm install",

  // Sobe o PostgreSQL a cada start — sai rápido se já estiver rodando
  "postStartCommand": "bash /workspace/scripts/start-db.sh"
}
